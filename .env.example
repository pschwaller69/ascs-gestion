DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Code pour ouvrir la page /installation (12 caractères minimum). À retirer une fois le premier compte créé.
SETUP_CODE=

# Adresse publique de l'application, utilisée dans les QR codes (ex. https://gestion.ascs.fr). Facultatif.
APP_URL=

# HelloAsso (API v5) — « Mon compte > Intégrations et API » sur helloasso.com
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
# Nom de l'association dans l'adresse helloasso.com/associations/<nom>
HELLOASSO_ORGANISATION=
# Facultatif : jeton secret (16 caractères minimum) pour les notifications instantanées.
# URL à déclarer chez HelloAsso : https://<votre-sous-domaine>/helloasso/notification/<ce jeton>
HELLOASSO_WEBHOOK_TOKEN=

# Envoi des mails (factures) : mail = serveur d'o2switch ; fichier = écrits dans storage/mails (tests)
MAIL_TRANSPORT=mail
