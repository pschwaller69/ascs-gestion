DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Code pour ouvrir la page /installation (12 caractères minimum). À retirer une fois le premier compte créé.
SETUP_CODE=

# Adresse publique de l'application, utilisée dans les QR codes (ex. https://gestion.ascs.fr). Facultatif.
APP_URL=

# HelloAsso (API v5) — « Mon compte > Intégrations et API » sur helloasso.com
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
# Nom de l'association dans l'adresse helloasso.com/associations/<nom>
HELLOASSO_ORGANISATION=
# Facultatif : jeton secret (16 caractères minimum) pour les notifications instantanées.
# URL à déclarer chez HelloAsso : https://<votre-sous-domaine>/helloasso/notification/<ce jeton>
HELLOASSO_WEBHOOK_TOKEN=

# Envoi des mails par un compte SMTP o2switch (recommandé : meilleure délivrabilité).
# Serveur : le nom de votre serveur cPanel ou mail.<domaine> (voir cPanel > Comptes de messagerie > Configurer le client de messagerie).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITE=ssl
SMTP_USER=contact@m.ascs.fr
SMTP_PASS=
# Facultatif : second compte réservé aux mailings en nombre (sinon le compte ci-dessus sert à tout)
SMTP_MAILING_USER=
SMTP_MAILING_PASS=

# Envoi des mails sans SMTP (si SMTP_HOST est vide) : mail = serveur d'o2switch ; fichier = écrits dans storage/mails (tests)
MAIL_TRANSPORT=mail

# SMS : application « SMS Gateway for Android » installée sur un téléphone de l'association (mode cloud).
# Identifiant et mot de passe affichés dans l'application. Laisser vide tant qu'aucun téléphone n'est prêt.
SMS_USER=
SMS_PASS=
# SMS_URL=https://api.sms-gate.app/3rdparty/v1/messages
# SMS_TRANSPORT=fichier   (tests : SMS écrits dans storage/sms)
